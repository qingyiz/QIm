# cmake/QImConfig.cmake.in
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(QIM_QT_VERSION_MAJOR @QT_VERSION_MAJOR@)
find_dependency(Qt${QIM_QT_VERSION_MAJOR} @QIM_MIN_QT_VERSION@ COMPONENTS Core Gui Widgets OpenGL)
if(QIM_QT_VERSION_MAJOR EQUAL 6)
    find_dependency(Qt6 @QIM_MIN_QT_VERSION@ COMPONENTS OpenGLWidgets)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/QImTargets.cmake")

set_and_check(QIM_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(QIM_LIBRARY_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")
set_and_check(QIM_BINARY_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@")

check_required_components(QIm)
